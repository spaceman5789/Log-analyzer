# systemd-юнит: log-analyzer watch как сервис.
# Установка:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin log-analyzer
#   sudo pip install .            # или pipx install .
#   sudo mkdir -p /etc/log-analyzer
#   sudo cp config.example.yaml /etc/log-analyzer/config.yaml
#   sudo install -m 600 -o log-analyzer .env /etc/log-analyzer/env   # TG_BOT_TOKEN / TG_CHAT_ID
#   sudo cp deploy/log-analyzer.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now log-analyzer
#   journalctl -u log-analyzer -f
[Unit]
Description=SSH brute force detector (log-analyzer watch)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=log-analyzer
# adm — чтение /var/log/auth.log; systemd-journal — для режима --journal
SupplementaryGroups=adm systemd-journal
EnvironmentFile=/etc/log-analyzer/env
ExecStart=/usr/local/bin/log-analyzer watch /var/log/auth.log \
    --config /etc/log-analyzer/config.yaml --telegram --no-color
# RHEL/Rocky: /var/log/secure; только journald: замените путь на --journal
Restart=on-failure
RestartSec=5

# Хардненинг: процессу нужно только читать логи и ходить в api.telegram.org
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
